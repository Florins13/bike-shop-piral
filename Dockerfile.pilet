# ──────────────────────────────────────────────
#  Build stage: produce a minified production pilet bundle
# ──────────────────────────────────────────────
FROM node:18 AS build

WORKDIR /app

# Copy the emulator tarball from the shell build
COPY dist/emulator/ /emulator/

# Copy pilet source
ARG PILET_DIR
COPY ${PILET_DIR}/package.json ./
COPY ${PILET_DIR}/tsconfig.json ${PILET_DIR}/pilet.json ./
COPY ${PILET_DIR}/src/ src/

# Update the piral-shell dependency path to point to the emulator inside the container
RUN sed -i 's|file:../dist/emulator/piral-shell-1.0.0.tgz|file:/emulator/piral-shell-1.0.0.tgz|g' package.json || true
RUN sed -i 's|file:../dist/emulator/piral-1.0.0.tgz|file:/emulator/piral-1.0.0.tgz|g' package.json || true

# Replace esbuild with the webpack5 bundler for Docker compatibility
RUN node -e "const p=require('./package.json'); if(p.devDependencies) { delete p.devDependencies['piral-cli-esbuild']; p.devDependencies['piral-cli-webpack5']='^1.11.0'; } require('fs').writeFileSync('./package.json', JSON.stringify(p,null,2));"

# Install dependencies
RUN npm install

# Production build: minified, optimized bundle written to /app/dist
RUN npx pilet build --bundler webpack5

# Generate the static pilet feed the shell fetches from /$pilet-api/.
# The link must be absolute and reachable from the browser, so it uses the
# public port this pilet is published on (see docker-compose.yml).
ARG PILET_PORT=1234
RUN node -e "const p=require('./package.json'); const fs=require('fs'); const port=process.env.PILET_PORT||'1234'; const feed=[{name:p.name,version:p.version,link:'http://localhost:'+port+'/index.js',spec:'v2'}]; fs.writeFileSync('/app/dist/feed.json', JSON.stringify(feed));"

# ──────────────────────────────────────────────
#  Serve stage: static hosting of the production bundle + feed via nginx
# ──────────────────────────────────────────────
FROM nginx:alpine

# Copy the built pilet bundle, chunks, assets and the generated feed
COPY --from=build /app/dist/ /usr/share/nginx/html/

# Nginx config that serves the feed at /$pilet-api/ and the bundle with CORS
COPY nginx.pilet.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
